{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SMaRT-Lab",
  "version": "0.2.0",
  "identifier": "com.smartlab.native",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SMaRT-Lab",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' * 'unsafe-inline' 'unsafe-eval' data: blob:; img-src * 'unsafe-inline' data: blob:; style-src * 'unsafe-inline'; font-src * data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src * 'unsafe-inline' 'unsafe-eval' data: blob: wss://*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
